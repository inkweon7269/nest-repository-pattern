NODE_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=local_user
DB_PASSWORD=local_password
DB_DATABASE=nest_repository

JWT_ACCESS_SECRET=your-access-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

JWT_ADMIN_ACCESS_EXPIRATION=15m
JWT_ADMIN_ACCESS_SECRET=your-admin-access-secret-key
JWT_ADMIN_REFRESH_EXPIRATION=7d
JWT_ADMIN_REFRESH_SECRET=your-admin-refresh-secret-key

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
GOOGLE_LINK_CALLBACK_URL=http://localhost:3000/v1/auth/google/link/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5173/oauth/callback

LOG_LEVEL=debug

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

REDIS_HOST=localhost
REDIS_PORT=6379

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# 폴백용 기본 service name. 실제 앱 식별자는 package.json start 스크립트에서 service / back-office로 분기 주입한다.
OTEL_SERVICE_NAME=nest-repository-pattern
# 단일 PostgreSQL 쿼리가 이 값(ms)을 넘으면 Slack #*-slow-query 채널로 알림. 0 또는 음수/잘못된 값이면 5000ms 폴백.
SLOW_QUERY_THRESHOLD_MS=5000

ADMIN_PORT=3001

# CORS (쉼표 구분 origin 목록, production 환경에서는 필수)
SERVICE_CORS_ORIGINS=https://app.example.com
BACK_OFFICE_CORS_ORIGINS=https://admin.example.com
